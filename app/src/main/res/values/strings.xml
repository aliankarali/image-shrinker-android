    <string name="conversion_footer">SVG and GIF files are always optimised in their own format. SVG is vector, and GIF is usually animated — converting either would lose what makes it useful.</string>

    <string name="section_quality">Quality</string>
    <string name="settings_encode_at">Encode at</string>
    <string name="quality_super_low">Super Low</string>
    <string name="quality_low">Low</string>
    <string name="quality_standard">Standard</string>
    <string name="quality_high">High</string>
    <string name="quality_footer">Applies to JPEG, WebP and AVIF. PNG and GIF are optimised by methods with no comparable setting, so they look the same whichever you choose. Every session starts here; the session bar can change it for one session without changing this.</string>

    <string name="section_metadata">Metadata</string>
